/* Codedevza AI Vault customisations. Loaded by /css/vaultwarden.css after the built-in rules. */

/* Org creation is restricted to ORG_CREATION_USERS; hide the entry points for everyone.
   Allowed admins can still open /#/create-organization directly. */
a[href$="/create-organization"],
a[routerlink="/create-organization"],
button[routerlink="/create-organization"],
/* product switcher's "Bitwarden for business" upsell */
a[href="https://bitwarden.com/products/business/"] {
  @extend %vw-hide;
}

/* Send → "Who can access" → "Specific people" (email verification). Vaultwarden
   rejects Sends with recipient emails ("Sends with email verification is not
   supported"), so hide the option instead of letting people hit the error.
   Options render in fixed order: anyone / specific people / password. */
tools-send-details [formcontrolname="authType"] bit-radio-button:nth-of-type(2),
tools-send-details [formcontrolname="authType"] > *:nth-child(2):has(input[type="radio"]) {
  @extend %vw-hide;
}
