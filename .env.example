# Copy to .env for local dev. On Railway, set these as service Variables instead.
# Full reference: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template

# Public URL clients use. Must match exactly (scheme + host + port).
DOMAIN=http://localhost:8080

# Lock down after creating your accounts.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
# Restrict signups to company domains (comma-separated). Empty = any.
SIGNUPS_DOMAINS_WHITELIST=

# Admin panel at /admin. Generate an argon2 hash with:
#   docker run --rm -it vaultwarden/server:1.37.3 /vaultwarden hash
# Leave empty to disable the admin panel.
ADMIN_TOKEN=

# Local Postgres password (docker-compose only; Railway provides DATABASE_URL).
POSTGRES_PASSWORD=vaultwarden

# Optional: SMTP for invites / 2FA / password hints.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vault@codedevza.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional: extra hardening
# SHOW_PASSWORD_HINT=false
# WEBSOCKET_ENABLED=true
# LOG_LEVEL=warn
